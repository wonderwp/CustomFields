{
  "name": "wonderwp/custom-fields",
  "description": "WonderWp Custom Fields Component",
  "type": "library",
  "keywords": ["custom fields", "WonderWp", "WordPress"],
  "homepage": "https://github.com/wonderwp/CustomFields",
  "license": "MIT",
  "authors": [
    {
      "name": "Jeremy Desvaux",
      "homepage": "https://jdmweb.com"
    },
    {
      "name": "WonderWp Community",
      "homepage": "http://wonderwp.net/Contribution/Contributors.html"
    }
  ],
  "require": {
    "php": "^8.3",
    "wonderwp/response": "dev-feature/php8"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {"WonderWp\\Component\\CustomFields\\": "src"},
    "exclude-from-classmap": [
      "/tests/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "WonderWp\\Component\\CustomFields\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist"
  },
  "minimum-stability": "dev"
}
